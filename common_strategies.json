{
  "strategies": [
    {
      "name": "主力建仓",
      "description": "T-1日涨幅<9.8%；T-10至T（含）至少5日满足结构日：收盘>昨收、收盘>开盘（阳线实体）、收盘站上5日线且5>10>20；上述命中日中至少一半满足5日与10日均线斜率向上。T日是否涨停仅作打标（main_force_t_limit_up_tag），不参与是否命中。",
      "strategy": {
        "conditions": [
          { "type": "main_force_build_position", "date1": 0, "windowDays": 10 }
        ],
        "exclude": {
          "kcb": true,
          "cyb": true,
          "bjs": true,
          "st": true,
          "delist": true
        },
        "timeRange": 120
      }
    },
    {
      "name": "断板反包",
      "description": "捕捉涨停后回调再反包的股票，适合低吸策略",
      "strategy": {
        "conditions": [
          { "type": "limit_up", "date1": -2 },
          { "type": "pct_change_lt", "date1": -1, "value": 0 },
          { "type": "limit_up", "date1": 0 },
          { "type": "volume_ratio", "date1": -1, "date2": -2, "ratio": 1.1 },
          { "type": "volume_ratio", "date1": 0, "date2": -2, "ratio": 1.3 }
        ],
        "exclude": {
          "kcb": true,
          "cyb": true,
          "bjs": true,
          "st": true,
          "delist": true
        },
        "timeRange": 90
      }
    },
    {
      "name": "筑底突破",
      "description": "捕捉双底形态突破买点。形态：涨一波→回调低点1→涨一小波→二次筑底→放量上涨=买点。",
      "strategy": {
        "conditions": [
          { "type": "bottoming_breakout" }
        ],
        "exclude": {
          "kcb": true,
          "cyb": true,
          "bjs": true,
          "st": true,
          "delist": true
        },
        "timeRange": 90
      }
    },
    {
      "name": "连阳上影",
      "description": "筛选连续连阳后的上影线个股：默认要求T日向前至少连阳3天，且连阳3天都满足5日线>10日线，并且这3天里至少1天上影线幅度大于2%。",
      "strategy": {
        "conditions": [
          { "type": "consecutive_up_days_gte", "date1": 0, "consecutiveDays": 3, "requireMa5GtMa10": true },
          { "type": "upper_shadow_pct_gt", "date1": 0, "days": 3, "value": 2 }
        ],
        "exclude": {
          "kcb": true,
          "cyb": true,
          "bjs": true,
          "st": true,
          "delist": true
        },
        "timeRange": 120
      }
    },
    {
      "name": "四连阳摸板",
      "description": "T日前（截至T-1日）连续涨跌幅>0的交易日不少于4天，且该连阳段内每日均未涨停（涨跌幅<9.8%）；T日最高价相对昨收涨幅≥9.8%（触及涨停价，收盘是否涨停不限）。",
      "strategy": {
        "conditions": [
          { "type": "consecutive_up_days_gte", "date1": -1, "consecutiveDays": 4 },
          { "type": "consecutive_up_window_no_limit_up", "date1": -1, "limitPct": 9.8 },
          { "type": "high_is_limit_up", "date1": 0 }
        ],
        "exclude": {
          "kcb": true,
          "cyb": true,
          "bjs": true,
          "st": true,
          "delist": true
        },
        "timeRange": 90
      }
    },
    {
      "name": "连阳超五无涨停",
      "description": "T日涨跌幅>0，且截至T日连续「涨跌幅>0」的交易日不少于6天（连涨天数>5）；该连阳区间内每日涨跌幅均<9.8%（无涨停，与现有涨停口径一致）。结果含 consecutive_up_days：截至条件锚点的连阳天数（本策略为 T）。",
      "strategy": {
        "conditions": [
          { "type": "consecutive_up_days_gte", "date1": 0, "consecutiveDays": 6 },
          { "type": "consecutive_up_window_no_limit_up", "date1": 0, "limitPct": 9.8 }
        ],
        "exclude": {
          "kcb": true,
          "cyb": true,
          "bjs": true,
          "st": true,
          "delist": true
        },
        "timeRange": 90
      }
    },
    {
      "name": "昨摸板今涨停",
      "description": "T-1日最高价相对前一日收盘涨幅≥9.8%（触及涨停价）但收盘未涨停（涨跌幅<9.8%）；T日涨停（涨跌幅≥9.8%）。",
      "strategy": {
        "conditions": [
          { "type": "touch_limit_not_close", "date1": -1 },
          { "type": "limit_up", "date1": 0 }
        ],
        "exclude": {
          "kcb": true,
          "cyb": true,
          "bjs": true,
          "st": true,
          "delist": true
        },
        "timeRange": 90
      }
    },
    {
      "name": "昨摸板今触板",
      "description": "T-1日最高价触及涨停价但未封板（涨跌幅<9.8%）；T日仅要求最高价触及涨停价（相对昨收≥9.8%），收盘封板与否均算命中。",
      "strategy": {
        "conditions": [
          { "type": "touch_limit_not_close", "date1": -1 },
          { "type": "high_is_limit_up", "date1": 0 }
        ],
        "exclude": {
          "kcb": true,
          "cyb": true,
          "bjs": true,
          "st": true,
          "delist": true
        },
        "timeRange": 90
      }
    },
    {
      "name": "T日摸板未封",
      "description": "T-3、T-2、T-1日涨跌幅均>0；T日最高价触及涨停价但收盘未涨停（涨跌幅<9.8%）。",
      "strategy": {
        "conditions": [
          { "type": "pct_change_gt", "date1": -3, "value": 0 },
          { "type": "pct_change_gt", "date1": -2, "value": 0 },
          { "type": "pct_change_gt", "date1": -1, "value": 0 },
          { "type": "touch_limit_not_close", "date1": 0 }
        ],
        "exclude": {
          "kcb": true,
          "cyb": true,
          "bjs": true,
          "st": true,
          "delist": true
        },
        "timeRange": 90
      }
    }
  ]
}
