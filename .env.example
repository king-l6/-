# 环境变量配置示例
# 复制此文件为 .env 并填入你的实际值
# 注意：.env 文件已添加到 .gitignore，不会被提交到Git仓库

# Tushare Token 配置（如需使用 Tushare 数据源）
TUSHARE_TOKEN=your_tushare_token_here

# 企业微信机器人 Webhook（可选，用于发送回测结果通知）
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here
